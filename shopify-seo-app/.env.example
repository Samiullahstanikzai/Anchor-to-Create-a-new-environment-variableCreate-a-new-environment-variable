# Copy this file to `.env` and fill in the values from your Shopify Partner Dashboard
# (Apps > Your App > Client credentials).

# --- Required ---
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Comma-separated list of Admin API access scopes the app needs.
SCOPES=read_products,write_products,read_content,write_content

# The publicly reachable HTTPS URL of this app (no trailing slash).
# During local development this is the URL from a tunnel (ngrok, Cloudflare
# Tunnel, `shopify app dev`, etc.). In production it's your real domain.
HOST=https://example-tunnel-url.trycloudflare.com

# --- Optional ---
PORT=3000

# Admin API version to call. Update as Shopify releases new stable versions.
SHOPIFY_API_VERSION=2024-10

# Where session/shop data is persisted. Defaults to a JSON file under ./data.
# Swap `src/lib/sessionStore.js` for a real database in production.
SESSION_DB_PATH=./data/sessions.json

# Shop name to use in generated SEO title suggestions, e.g. "| My Store".
# Falls back to the shop's name fetched from the Admin API if unset.
STORE_DISPLAY_NAME=
